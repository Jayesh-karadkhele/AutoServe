# AutoServe Platform - Environment Variables Documentation Template
# -----------------------------------------------------------------------------
# IMPORTANT SECURITY NOTES:
# 1. This file (.env.example) is for DOCUMENTATION PURPOSES ONLY.
# 2. Spring Boot DOES NOT automatically load a root .env file at runtime.
# 3. Developers MUST configure these variables in their IDE run configuration,
#    operating system environment, terminal session, or Docker container.
# 4. NEVER commit real passwords, secret keys, or API tokens to source control.
# -----------------------------------------------------------------------------

# Active Spring Profile (options: dev, prod, demo)
SPRING_PROFILES_ACTIVE=dev

# MySQL Database Configuration
DB_URL=jdbc:mysql://localhost:3306/autoserve_dev
DB_USERNAME=autoserve_app
DB_PASSWORD=replace_with_local_database_password

# JWT & Authentication Lifetime Settings (Secret MUST be at least 512 bits / 64 bytes long for HS512)
JWT_SECRET=replace_with_a_minimum_64_byte_random_secret_for_HS512
JWT_ACCESS_EXPIRATION=900000
REFRESH_TOKEN_EXPIRATION=604800000
AUTH_SESSION_EXPIRATION=604800000

# Refresh Cookie Security Configuration
REFRESH_COOKIE_NAME=AUTOSERVE_REFRESH
REFRESH_COOKIE_SECURE=true
REFRESH_COOKIE_SAME_SITE=Strict
REFRESH_COOKIE_DOMAIN=

# Optional First-Admin Bootstrap Configuration (Default: disabled)
APP_BOOTSTRAP_ADMIN_ENABLED=false
BOOTSTRAP_ADMIN_EMAIL=admin@autoserve.com
BOOTSTRAP_ADMIN_PASSWORD=replace_with_strong_admin_password
BOOTSTRAP_ADMIN_NAME="System Administrator"
BOOTSTRAP_ADMIN_PHONE=9999999999

# Razorpay Integration Credentials
RAZORPAY_KEY_ID=replace_with_razorpay_key_id
RAZORPAY_KEY_SECRET=replace_with_razorpay_key_secret

# Cloudinary Storage Credentials
CLOUDINARY_CLOUD_NAME=replace_with_cloudinary_cloud_name
CLOUDINARY_API_KEY=replace_with_cloudinary_api_key
CLOUDINARY_API_SECRET=replace_with_cloudinary_api_secret

# SMTP Email Configuration
MAIL_HOST=smtp.example.com
MAIL_PORT=587
MAIL_USERNAME=replace_with_mail_username
MAIL_PASSWORD=replace_with_mail_password
MAIL_FROM=noreply@example.com

# Frontend & Business Logic
FRONTEND_URL=http://localhost:5173
CORS_ALLOWED_ORIGINS=http://localhost:5173
INVOICE_TAX_PERCENTAGE=18

# Optional Development / Demo-Only Data Seeding (Requires SPRING_PROFILES_ACTIVE=demo)
APP_DEMO_SEED_ENABLED=false
DEMO_ADMIN_PASSWORD=replace_only_when_demo_seeding_is_required
DEMO_MANAGER_PASSWORD=replace_only_when_demo_seeding_is_required
DEMO_MECHANIC_PASSWORD=replace_only_when_demo_seeding_is_required
DEMO_CUSTOMER_PASSWORD=replace_only_when_demo_seeding_is_required

